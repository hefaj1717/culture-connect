  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:unit:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:db": "supabase test db --local",
    "test:e2e": "bash scripts/run-maestro-local.sh",
    "test:e2e:flows": "$HOME/.maestro/bin/maestro test .maestro/flows",
    "test:e2e:backend": "node scripts/test-e2e-backend.mjs",
    "test:e2e:reset": "supabase db reset --local",
    "lint": "expo lint",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=moderate",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:check": "npm run security:audit && npm run security:secrets",
    "quality:frontend": "npm run lint && npx tsc --noEmit && npm run test:unit && npm run security:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "postcss": "8.5.28",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  }
